node_modules/
.env
.env.*
!.env.example

# The server's own secrets file. `.env.*` above does NOT match `api.env` — the
# pattern needs the name to START with `.env` — so this file was ignored by
# nothing, in a PUBLIC repository, while holding the live ElevenLabs key and
# (from #22/#23) the live Stripe keys.
#
# The deploy copies engine/**, so a committed api.env would also overwrite the
# server's own copy on the next push.
engine/api.env
*.env
*.log
__pycache__/

# render pipeline working dirs / outputs (regenerable, or large binaries)
renders/
*_segments_raw/
*_segments/
qa_whisper_boost_*.wav
*.wav
*.mp3

# frontend build output (built in CI)
web/dist/

# voice preview clips ARE source assets — re-include them
!web/public/voices/*.mp3

# Planning and review documents (#18 follow-up, at the owner's request).
# Untracked rather than deleted — the files stay on disk, they simply stop
# being published. History still contains the earlier commits; removing those
# would need a rewrite and a force-push, which is a separate decision.
tasks/
