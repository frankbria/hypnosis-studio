# Hypnosis Studio — environment
#
# Copy to .env and fill in. `.gitignore` covers .env and .env.* ; this example
# file is the one exception, so keep real secrets out of it.
#
# server.js reads .env from its own directory at startup (process.loadEnvFile),
# so `node server.js`, `npm start` and systemd all pick it up — no flag needed.
# Values already present in the real environment WIN over this file, so systemd
# beats a stale .env left in a deploy directory.
#
# The frontend is different: VITE_* variables are read by Vite at BUILD time and
# inlined into the bundle. Changing one means rebuilding, not restarting.
#
# Every value below is optional EXCEPT ELEVENLABS_API_KEY. The defaults shown
# are what the code actually falls back to — they are not suggestions.

# ─── Required ────────────────────────────────────────────────────────────────

# The only true secret. Without it the engine cannot voice anything, and a
# render fails at the TTS step rather than at startup.
# Billed per character, which is what MONTHLY_CHAR_BUDGET below guards.
ELEVENLABS_API_KEY=

# ─── Access ──────────────────────────────────────────────────────────────────

# Prototype gate on the render endpoint. Empty means no code is required, which
# is the current default — set it before anything is reachable publicly.
# ACCESS_CODE=

# ─── Support address (#18) ───────────────────────────────────────────────────

# Shown on the refund policy and linked in the footer. Read at BUILD time by
# Vite, so changing it means rebuilding the frontend — it is baked into the
# bundle, not read at runtime.
#
# Falls back to frank.bria@pm.me when unset. Set this in prod rather than
# editing the source.
#
# It must be monitored by a person: /refunds tells customers a person reads it.
# VITE_SUPPORT_EMAIL=support@example.com

# ─── Server ──────────────────────────────────────────────────────────────────

# PORT=4100
# RENDERS_DIR=./renders                      # where job directories are written
# SEGMENT_CACHE_DIR=<RENDERS_DIR>/segment-cache

# Python interpreter for the engine. The default assumes engine/venv exists;
# override when the venv lives elsewhere or in a container.
# ENGINE_PY=./engine/venv/bin/python

# ─── Limits and cost control ─────────────────────────────────────────────────

# Renders started per calendar day, across all users.
# MAX_JOBS_PER_DAY=6

# ElevenLabs characters per calendar month. The server refuses a render it
# cannot pay for rather than discovering the ceiling mid-job, and refunds the
# ledger when a job fails.
# MONTHLY_CHAR_BUDGET=500000

# A worker exceeding this is killed. 45 minutes; a render is 15-20.
# HARD_TIMEOUT_MS=2700000

# ─── Retention ───────────────────────────────────────────────────────────────

# How long a finished render stays downloadable, in days.
#
# WARNING: the site states this number in prose on /terms and /privacy, baked in
# at build time. Setting it SHORTER than what the site advertises means deleting
# files while customers have been told they still have them. See #103.
# RETENTION_DAYS=30

# Log what the sweep would delete without deleting it. Useful on first deploy.
# RETENTION_DRY_RUN=1

# How often the retention/stale-job sweep runs. Lowered by tests; leave alone.
# SWEEP_INTERVAL_MS=60000

# ─── Engine internals ────────────────────────────────────────────────────────

# Working dtype for the mix. Defaults to float32; float64 roughly doubles peak
# memory and is only worth it when chasing a numerical difference.
# HYPNO_DTYPE=float32

# Skip the shippability gate. For development only — it is the check that stops
# a silent or truncated program reaching a customer.
# HYPNO_SKIP_QA=1
